# Environment Configuration
NODE_ENV=development

# Appium Server
APPIUM_HOST=localhost
APPIUM_PORT=4723

# Android Configuration
ANDROID_APP_PATH=./apps/android/app-debug.apk
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=13.0

# iOS Configuration
IOS_APP_PATH=./apps/ios/app.app
IOS_DEVICE_NAME=iPhone 14 Pro
IOS_PLATFORM_VERSION=16.0
IOS_UDID=auto

# BrowserStack App Automate (cloud device farm)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_ANDROID_APP_ID=
BROWSERSTACK_ANDROID_DEVICE_NAME=Google Pixel 7
BROWSERSTACK_ANDROID_OS_VERSION=13.0
BROWSERSTACK_IOS_APP_ID=
BROWSERSTACK_IOS_DEVICE_NAME=iPhone 14 Pro
BROWSERSTACK_IOS_OS_VERSION=16.0

# Test Configuration
DEFAULT_TIMEOUT=30000
IMPLICIT_WAIT=5000
EXPLICIT_WAIT=10000

# Execution
MAX_INSTANCES=2
LOG_LEVEL=info

# Reporting
ALLURE_RESULTS_DIR=./reports/allure-results
SCREENSHOT_DIR=./reports/screenshots
VIDEO_DIR=./reports/videos

# API Configuration (for API testing integration)
API_BASE_URL=https://api.example.com
API_TIMEOUT=10000
