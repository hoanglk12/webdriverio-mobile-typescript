{
  "mcpServers": {
    "appium-mcp": {
      "type": "stdio",
      "command": "appium-mcp.cmd",
      "args": [],
      "env": {
        "ANDROID_HOME": "C:\\Android\\Sdk",
        "ANDROID_SDK_ROOT": "C:\\Android\\Sdk"
      }
    },
    "lightrag": {
      "command": "uvx",
      "args": [
        "--from", "lightrag-mcp",
        "--with", "mcp<2",
        "lightrag-mcp",
        "--host", "localhost",
        "--port", "9623"
      ]
    }
  }
}
