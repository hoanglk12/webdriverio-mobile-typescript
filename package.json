{
  "name": "webdriverio-mobile-typescript",
  "version": "1.0.0",
  "description": "Enterprise-grade Mobile Automation Framework with WebdriverIO, Mocha, Chai, and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:parallel": "wdio run ./config/wdio.conf.ts --spec ./tests/specs/**/*.spec.ts",
    "test:smoke": "wdio run ./config/wdio.conf.ts --suite smoke",
    "test:regression": "wdio run ./config/wdio.conf.ts --suite regression",
    "test:verify": "npm run type-check && npm run lint",
    "verify": "powershell -ExecutionPolicy Bypass -File ./verify-framework.ps1",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "node -e \"const fs = require('fs'); if (fs.existsSync('.git')) { const { execSync } = require('child_process'); try { execSync('npx husky install', { stdio: 'inherit' }); } catch (e) {} }\"",
    "postinstall": "echo Setup complete. Run 'git init' and 'npx husky install' to enable Git hooks.",
    "clean": "rimraf ./reports ./node_modules/.cache",
    "appium": "appium",
    "appium:doctor": "appium-doctor"
  },
  "keywords": [
    "webdriverio",
    "mocha",
    "chai",
    "typescript",
    "mobile-automation",
    "appium",
    "android",
    "ios",
    "page-object-model",
    "allure"
  ],
  "author": "Your Team",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.7.9",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@wdio/allure-reporter": "^9.2.3",
    "@wdio/appium-service": "^9.2.3",
    "@wdio/cli": "^9.2.3",
    "@wdio/globals": "^9.2.3",
    "@wdio/local-runner": "^9.2.3",
    "@wdio/mocha-framework": "^9.2.3",
    "@wdio/spec-reporter": "^9.2.3",
    "@wdio/types": "^9.2.3",
    "allure-commandline": "^2.32.0",
    "appium": "^2.13.1",
    "appium-doctor": "^1.16.2",
    "appium-uiautomator2-driver": "^3.8.5",
    "appium-xcuitest-driver": "^7.32.1",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "webdriverio": "^9.2.3",
    "winston": "^3.17.0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
