{
  "name": "webdriverio-mobile-typescript",
  "version": "1.0.0",
  "description": "Enterprise-grade Mobile Automation Framework with WebdriverIO, Mocha, Chai, and TypeScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:parallel": "wdio run ./config/wdio.conf.ts --spec ./tests/specs/**/*.spec.ts",
    "test:smoke": "wdio run ./config/wdio.conf.ts --suite smoke",
    "test:regression": "wdio run ./config/wdio.conf.ts --suite regression",
    "test:browserstack:android": "wdio run ./config/wdio.browserstack.android.conf.ts",
    "test:browserstack:ios": "wdio run ./config/wdio.browserstack.ios.conf.ts",
    "browserstack:upload:android": "tsx scripts/uploadAppToBrowserStack.ts android",
    "browserstack:upload:ios": "tsx scripts/uploadAppToBrowserStack.ts ios",
    "test:verify": "npm run type-check && npm run lint",
    "verify": "powershell -ExecutionPolicy Bypass -File ./verify-framework.ps1",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "node -e \"const fs = require('fs'); if (fs.existsSync('.git')) { const { execSync } = require('child_process'); try { execSync('npx husky install', { stdio: 'inherit' }); } catch (e) {} }\"",
    "postinstall": "echo Setup complete. Run 'git init' and 'npx husky install' to enable Git hooks.",
    "clean": "rimraf ./reports ./node_modules/.cache",
    "appium": "appium",
    "appium:doctor": "appium-doctor"
  },
  "keywords": [
    "webdriverio",
    "mocha",
    "chai",
    "typescript",
    "mobile-automation",
    "appium",
    "android",
    "ios",
    "page-object-model",
    "allure"
  ],
  "author": "Your Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/browserstack-service": "^9.33.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/types": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "appium": "^3.6.0",
    "appium-doctor": "^1.16.2",
    "appium-uiautomator2-driver": "^8.6.1",
    "appium-xcuitest-driver": "^12.3.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "webdriverio": "^9.30.1",
    "winston": "^3.19.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.0.0"
  }
}
