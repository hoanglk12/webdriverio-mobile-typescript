# Environment Configuration
NODE_ENV=development

# Appium Server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Android Configuration
# Full Android SDK (platform-tools + build-tools) installed at C:\Android\Sdk —
# appium-adb needs real build-tools (aapt2, apksigner, zipalign), which a plain
# Genymotion install does not ship. Genymotion itself is configured (via
# `gmtool config --use_custom_sdk on --sdk_path`) to use this same SDK's adb,
# so there's only one adb daemon version in play — don't point ANDROID_HOME
# back at the Genymotion folder, and don't let Genymotion's own bundled adb
# run alongside this one (mismatched adb server versions kick each other out).
ANDROID_HOME=C:\Android\Sdk
ANDROID_APP_PATH=./apps/android/FrontRow.apk
ANDROID_DEVICE_NAME=192.168.56.101:5555
ANDROID_PLATFORM_VERSION=13.0
# FrontRow (https://github.com/majdukovic/frontrow) — QA training app used to
# smoke-test this framework end-to-end. Explicit package/activity skip
# Appium's aapt2-based APK inspection at session start.
ANDROID_APP_PACKAGE=app.frontrow.qa
ANDROID_APP_ACTIVITY=.MainActivity

# iOS Configuration
IOS_APP_PATH=./apps/ios/app.app
IOS_DEVICE_NAME=iPhone 14 Pro
IOS_PLATFORM_VERSION=16.0
IOS_UDID=auto

# Test Configuration
DEFAULT_TIMEOUT=30000
IMPLICIT_WAIT=5000
EXPLICIT_WAIT=10000

# Execution
MAX_INSTANCES=2
LOG_LEVEL=info

# Reporting
ALLURE_RESULTS_DIR=./reports/allure-results
SCREENSHOT_DIR=./reports/screenshots
VIDEO_DIR=./reports/videos

# API Configuration (for API testing integration)
API_BASE_URL=https://api.example.com
API_TIMEOUT=10000
